#!/bin/sh
set -eu
input=''
output=''
while [ "$#" -gt 0 ]; do
  case "$1" in
    -i) input=$2; shift 2 ;;
    -o) output=$2; shift 2 ;;
    --minify) shift ;;
    *) echo "unexpected argument: $1" >&2; exit 2 ;;
  esac
done
[ -f "$input" ] || { echo "missing input" >&2; exit 2; }
[ -n "$output" ] || { echo "missing output" >&2; exit 2; }
mode=$(sed -n 's@/\* FAKE_MODE=\([a-z]*\) \*/@\1@p' "$input" | head -1)
case "${mode:-success}" in
  fail) echo 'fake stdout'; echo 'fake stderr' >&2; exit 3 ;;
  missing) exit 0 ;;
  empty) : > "$output"; exit 0 ;;
  wrong) printf '/*! tailwindcss v4.3.2 | MIT License */\n' > "$output" ;;
  success) printf '/*! tailwindcss v4.3.3 | MIT License | https://tailwindcss.com */\n.bg-red-500{color:red}.md\\:flex{display:flex}.md\\:text-center{text-align:center}\n' > "$output" ;;
  *) exit 2 ;;
esac
